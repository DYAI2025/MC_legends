<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dyai.mcl-backup</string>

  <!-- The audio store is live. A missing media path must fail rather than make a
       database-only set look complete. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>MCL_BACKUP_REQUIRE_MEDIA</key>
    <string>1</string>
  </dict>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/benjaminpoersch/Projects/MC_legends/scripts/backup-mc-legends.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/benjaminpoersch/Projects/MC_legends</string>

  <!-- Daily at 13:00 local time. RunAtLoad also catches up after login or wake. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>13</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/benjaminpoersch/Backups/mc-legends/backup.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/benjaminpoersch/Backups/mc-legends/backup.log</string>
</dict>
</plist>
