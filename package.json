{
  "name": "mc-legends",
  "version": "0.1.0",
  "private": true,
  "description": "Avaloria web foundation for the MC Legends project.",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.18.1 <25",
    "npm": ">=11.16.0 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "MCL_CLOUDFLARE_BUILD=1 opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:architecture": "vitest run tests/architecture",
    "check:foundation": "node scripts/check-foundation.mjs",
    "check:integration-ran": "node scripts/check-integration-tests-ran.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "verify": "npm run check:foundation && npm run check:secrets && npm run lint && npm run typecheck && npm run test && npm run build",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:client-secrets": "node scripts/check-client-secrets.mjs",
    "check:cloudflare-bundle": "node scripts/check-cloudflare-bundle.mjs"
  },
  "dependencies": {
    "next": "16.3.0",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@playwright/test": "1.62.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.25.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "fake-indexeddb": "6.2.5",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "wrangler": "4.124.0"
  }
}
